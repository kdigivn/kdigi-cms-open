# KDIGI CMS — environment variables.
# Copy to `.env` (git-ignored) for local development:  cp .env.example .env
# Everything here is a placeholder. Never commit real values.
#
# Using `docker compose up`? You need NOTHING in this file: the stack provisions its own
# database and generates a PAYLOAD_SECRET on first start. Only the "Docker Compose" section
# below applies to that path.

# =============================================================================
# REQUIRED
# =============================================================================

# Postgres connection string.
# `docker compose up db` starts a matching local database on localhost:5432.
DATABASE_URI=postgres://kdigi:kdigi@localhost:5432/kdigi

# Secret used to sign admin sessions / API keys. MUST be at least 32 random characters
# (the server refuses to boot in production otherwise). Generate one with:
#   openssl rand -hex 32
PAYLOAD_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# Public URL of THIS CMS as browsers reach it (admin origin + prefix of media URLs).
# Use your real https:// URL in production, e.g. https://cms.example.com
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# =============================================================================
# MEDIA STORAGE  (all optional — local disk works out of the box)
# =============================================================================

# Directory for uploaded files when a site has no Cloudflare R2 config.
# Default: ./media (Docker: /app/media on the media_data volume).
# MEDIA_DIR=./media

# Cloudflare R2 is configured PER SITE in the admin (Sites -> System -> Cloudflare R2:
# bucket, account id, keys, public URL) — there are no global R2 env vars. A site with R2
# config uploads to R2; every other site uses local disk.
# Set R2_OFF=true to force local disk for every site (e.g. developing against a copy of
# production data without touching the bucket).
# R2_OFF=true

# =============================================================================
# FRONTEND INTEGRATION  (optional)
# =============================================================================

# Content saves queue "revalidate frontend" jobs (POST https://<Sites.domain>/api/cms/revalidate).
# Queued jobs only RUN when this is "true" — set it on exactly ONE instance (Payload has no
# cross-instance job lock). Without it, jobs are queued but never executed.
# ENABLE_JOBS_AUTORUN=true

# Public base URL of your frontend, used to build canonical document URLs in the admin.
# Applies to ALL sites and overrides Sites.domain — leave unset on multi-site installs.
# Fallback chain: this value -> Sites.domain -> http://localhost:3002
# FRONTEND_BASE_URL=https://www.example.com

# Sent as header `x-revalidate-secret` on every revalidate ping so a frontend can verify the caller.
# REVALIDATE_SECRET=

# Public demo login (opt-in): these users cannot change their own email/password/API key or delete
# themselves. `pnpm demo:reset` resets the `demo` site and these users' password to DEMO_ACCOUNT_PASSWORD.
# DEMO_ACCOUNT_EMAILS=demo@example.com
# DEMO_ACCOUNT_PASSWORD=

# =============================================================================
# AI SEO  (optional — the AI SEO buttons are disabled/erroring without a key)
# =============================================================================

# DeepSeek (OpenAI-compatible) key + model id. Verify with: pnpm verify:deepseek
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# Max AI SEO generations per user per minute (default 20).
# SEO_AI_RATE_LIMIT=20

# =============================================================================
# COMMENTS  (optional)
# =============================================================================

# Google reCAPTCHA secret key for POST /api/comments/create (the frontend sends `recaptchaToken`).
# Production logs a warning when unset because the endpoint is then open to spam.
# RECAPTCHA_SECRET=
# Webhook that receives every new pending comment (POST JSON). Unset = disabled.
# MODERATION_WEBHOOK_URL=https://example.com/hooks/new-comment

# =============================================================================
# OBSERVABILITY  (optional)
# =============================================================================

# OTEL_SERVICE_NAME=kdigi-cms
# OpenTelemetry collector base URL (traces are sent to <url>/v1/traces). Unset = no export.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# =============================================================================
# WORDPRESS MIGRATION  (optional — only for the importer, see docs/wordpress-migration/README.md)
# =============================================================================

# WordPress login used to capture private/unattached media during the archive phase.
# WP_AUTH_USER=
# WP_AUTH_PASSWORD=
# UTC offset to assume for WordPress dates that carry no timezone (default +00:00).
# WP_UTC_OFFSET=+07:00
# Name recorded as approver when you lock the staged-content gate (default: OS user).
# GATE_APPROVER=

# =============================================================================
# DOCKER COMPOSE  (only read by docker-compose.yml)
# =============================================================================

# POSTGRES_PASSWORD=kdigi          # database password (default: kdigi — local only)
# DB_PORT=5432                     # host port for Postgres (bound to 127.0.0.1)
# APP_PORT=3000                    # host port for the CMS
# SEED_DEMO=true                   # load the demo site + sample content on start (idempotent)
# SKIP_MIGRATIONS=true             # container only: skip the automatic `payload migrate`

# =============================================================================
# TESTS  (development only)
# =============================================================================

# PAYLOAD_INTEGRATION=1            # enable *.integration.test.ts against a LOCAL database
# PW_BASE_URL=http://localhost:3101   # Playwright e2e target
# PW_SKIP_WEB_SERVER=1             # reuse an already-running dev server in Playwright

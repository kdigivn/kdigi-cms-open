{
  "name": "@kdigi/kcms-cli",
  "version": "0.1.0",
  "description": "kcms — command line and MCP bridge for KDIGI CMS: write, edit and publish content from your terminal or AI agent",
  "license": "MIT",
  "author": "KDIGI <https://kdigi.vn>",
  "homepage": "https://github.com/kdigivn/kdigi-cms-open/blob/main/docs/ai-integration.md",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kdigivn/kdigi-cms-open.git",
    "directory": "packages/kcms-cli"
  },
  "bugs": {
    "url": "https://github.com/kdigivn/kdigi-cms-open/issues"
  },
  "keywords": ["kdigi", "cms", "mcp", "cli", "payload", "ai-agent"],
  "type": "module",
  "bin": {
    "kcms": "dist/cli.js"
  },
  "files": ["dist", "skills", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/bundle-skill.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "commander": "^14.0.0",
    "yaml": "^2.8.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "tsx": "^4.22.4",
    "typescript": "5.7.3"
  }
}
